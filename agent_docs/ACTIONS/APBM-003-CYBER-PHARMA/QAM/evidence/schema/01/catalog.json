        "check": "T-21 handle_new_user def",
        "def": "CREATE OR REPLACE FUNCTION public.handle_new_user()\n RETURNS trigger\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO ''\nAS $function$\nbegin\n insert into public.user_roles(user_id,role) values(new.id,'member'::public.app_role)\n on conflict(user_id) do nothing;\n insert into public.profiles(id,email,full_name) values(new.id,new.email,new.raw_user_meta_data->>'full_name')\n on conflict(id) do nothing;\n return new;\nend;\n$function$\n"
      }
