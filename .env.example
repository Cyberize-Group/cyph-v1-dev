# Copy this file to .env.local and fill in your own values.
# .env.local is gitignored — never commit real keys.

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase — from your project's API settings
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_publishable_key
SUPABASE_SECRET_KEY=sb_secret_your_service_role_key

# ---------- Mail guard (APBM-007B; amended 20 Nov 2026 for stakeholder testing) ----------
# Exact recipients allowed to receive invitation mail (comma-separated). Empty = nobody. "*" is ignored.
# MAIL_ALLOWLIST=owner@example.com
# allowlist (default) | open. "open" admits any single valid address ONLY on the DEV/alpha Supabase project
# yrsuwikjnbmvpznrgydb; on any other project it is ignored and the allowlist applies. MAIL_GUARD=off is ignored.
# MAIL_RECIPIENT_POLICY=allowlist
# Support address shown to users (default: the contract-recorded support@pharmacybooks.com).
# NEXT_PUBLIC_SUPPORT_EMAIL=
